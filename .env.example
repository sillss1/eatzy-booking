# Application
APP_NAME=EatZy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=lbaw25145
DB_USERNAME=postgres
DB_PASSWORD=password

# Session
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# =============================================
# EMAIL CONFIGURATION (Mailtrap for development)
# =============================================
# Sign up at https://mailtrap.io (free) and copy your credentials
# Or use Gmail with App Password (see README.md for instructions)

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@eatzy.com
MAIL_FROM_NAME="${APP_NAME}"

